PROJECT_NAME           = "HypeR C SDK"
PROJECT_NUMBER         = $(HYPER_DOC_REVISION)
OUTPUT_DIRECTORY       = $(HYPER_DOC_C_OUTPUT)
INPUT                  = sdk/abi/include lib/hyper/include lib/hyper/src lib/loader/src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = .
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = .
FULL_PATH_NAMES        = YES
HAVE_DOT               = NO
QUIET                  = YES
