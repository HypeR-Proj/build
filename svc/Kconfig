menu "System / Services"

config SYSTEM_APP_COMPONENT_MANAGER
    bool "component-manager (/svc/component-manager)"
    default y
    help
        Build and deploy hyper-component-manager at /svc/component-manager.
        Startup coordinator and service topology come from the selected profile.

config SYSTEM_APP_CONSOLE_RAW_SYSTEM
    bool "console-raw-system (/svc/console-raw)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-console-raw-system at /svc/console-raw.

config SYSTEM_APP_FS_BACKEND_SYSTEM
    bool "fs-backend-system (/svc/fs-backend)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-fs-backend-system at /svc/fs-backend.

config SYSTEM_APP_FS_EROFS_SYSTEM
    bool "fs-erofs-system (/svc/fs-erofs)"
    default y
    depends on SYSTEM_APP_FS_BACKEND_SYSTEM
    help
        Build and deploy hyper-fs-erofs-system at /svc/fs-erofs.

config SYSTEM_APP_FS_FAT_SYSTEM
    bool "fs-fat-system (/svc/fs-fat)"
    default y
    depends on SYSTEM_APP_FS_BACKEND_SYSTEM
    help
        Build and deploy hyper-fs-fat-system at /svc/fs-fat.

config SYSTEM_APP_IO_RUNTIME_SYSTEM
    bool "io-runtime-system (/svc/io-runtime)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-io-runtime-system at /svc/io-runtime.

config SYSTEM_APP_SESSION_MANAGER
    bool "session-manager (/svc/session-manager)"
    default y
    depends on SYSTEM_APP_TERMINAL_SERVICE && SYSTEM_APP_SH && SYSTEM_APP_COMPONENT_MANAGER && SYSTEM_APP_SVC_JOURNAL
    help
        Build and deploy hyper-session-manager at /svc/session-manager.

config SYSTEM_APP_SVC_BOOTSTRAP_RETIRE
    bool "svc/bootstrap-retire (/svc/bootstrap-retire)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-bootstrap-retire at /svc/bootstrap-retire.

config SYSTEM_APP_SVC_JOURNAL
    bool "svc/journal (/svc/journal)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-journald at /svc/journal.

config SYSTEM_APP_SYSTEM_STARTUP
    bool "system-startup (/svc/system-startup)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER && SYSTEM_APP_CONSOLE_RAW_SYSTEM && SYSTEM_APP_SVC_JOURNAL && SYSTEM_APP_SVC_BOOTSTRAP_RETIRE
    help
        Build and deploy hyper-system-startup at /svc/system-startup.

config SYSTEM_APP_TERMINAL_SERVICE
    bool "terminal-service (/svc/terminal-service)"
    default y
    depends on SYSTEM_APP_CONSOLE_RAW_SYSTEM
    help
        Build and deploy hyper-terminal-service at /svc/terminal-service.

config SYSTEM_APP_VM_MANAGER
    bool "vm-manager (/svc/vm-manager)"
    default y
    depends on SYSTEM_APP_VM_RUNTIME && SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-vm-manager at /svc/vm-manager.

config SYSTEM_APP_VM_RUNTIME
    bool "vm-runtime (/svc/vm-runtime)"
    default y
    depends on SYSTEM_APP_COMPONENT_MANAGER
    help
        Build and deploy hyper-vm-runtime at /svc/vm-runtime.

endmenu
