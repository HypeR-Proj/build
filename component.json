{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "build",
  "kind": "infrastructure",
  "tests": [
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "{component}/build-tests",
      "-p",
      "test_*.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/app-deployment.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/board-image-update.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/board-image.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/boot-profiles.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/developer-entrypoints.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/fetch-rpi5-boot.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/guest-rootfs.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/incremental.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/io-vm-package.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/io-vm-run.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/kernel-version.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/menuconfig.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/native-libraries.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/rpi5-bringup.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/service-manifest.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/system-config.py"
    ],
    [
      "python3",
      "-B",
      "tests/build/source-archive.py"
    ],
    [
      "python3",
      "{component}/scripts/check-workspace.py",
      "--root",
      "{system}"
    ]
  ],
  "build": {
    "makefile": "mk/system.mk"
  },
  "artifacts": [
    {
      "symlink": "lib64",
      "destination": "lib",
      "mode": "0777",
      "profiles": [
        "system",
        "development"
      ],
      "environment": "system"
    }
  ],
  "workspace": {
    "product_policy": "mk/workspace/product.Kconfig",
    "files": {
      "mk/workspace/configs": "configs",
      "build-tests/build": "tests/build",
      "scripts": "scripts",
      "mk": "mk",
      "tools": "tools",
      "rust-toolchain.toml": "rust-toolchain.toml"
    }
  },
  "config": null,
  "include": [
    {
      "project": "app"
    },
    {
      "project": "svc"
    },
    "components/libraries.json",
    "components/platform.json",
    "components/development.json"
  ]
}
